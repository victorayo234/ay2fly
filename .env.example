# ─── Supabase Configuration ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── PostgreSQL Database Connection Strings ─────────────────────────
DATABASE_URL=postgres://postgres:password@your-host:5432/postgres?sslmode=require
POSTGRES_URL=postgres://postgres:password@your-host:6543/postgres?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://postgres:password@your-host:5432/postgres?sslmode=require
